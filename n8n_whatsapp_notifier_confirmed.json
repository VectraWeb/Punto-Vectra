    {
      "parameters": {
        "authentication": "serviceAccount",
        "resource": "document",
        "operation": "query",
        "projectId": "andimeet-93f62",
        "database": "(default)",
        "query": "{\n  \"structuredQuery\": {\n    \"from\": [{ \"collectionId\": \"reservations\" }],\n    \"where\": {\n      \"compositeFilter\": {\n        \"op\": \"AND\",\n        \"filters\": [\n          {\n            \"fieldFilter\": {\n              \"field\": { \"fieldPath\": \"date\" },\n              \"op\": \"GREATER_THAN_OR_EQUAL\",\n              \"value\": { \"stringValue\": \"{{ (() => { const d = new Date(); d.setDate(d.getDate() - 1); return d.toLocaleDateString('en-CA', { timeZone: 'America/Argentina/Buenos_Aires' }); })() }}\" }\n            }\n          },\n          {\n            \"fieldFilter\": {\n              \"field\": { \"fieldPath\": \"date\" },\n              \"op\": \"LESS_THAN_OR_EQUAL\",\n              \"value\": { \"stringValue\": \"{{ new Date().toLocaleDateString('en-CA', { timeZone: 'America/Argentina/Buenos_Aires' }) }}\" }\n            }\n          }\n        ]\n      }\n    }\n  }\n}",
        "simple": true
      },
      "id": "notifier-firestore-all-reservas",
      "name": "Firestore GET ALL: reservas",
      "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
      "typeVersion": 1.1,
      "position": [
        -2160,
        480
      ],
      "credentials": {
        "googleApi": {
          "id": "4oMTtyVYbyEwbL9v",
          "name": "Google Service Account account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.all().map(i => i.json);\nlet docs = [];\nfor (const it of input) {\n  if (Array.isArray(it)) docs = docs.concat(it);\n  else if (it && Array.isArray(it.documents)) docs = docs.concat(it.documents);\n  else if (it && Array.isArray(it.items)) docs = docs.concat(it.items);\n  else if (it && Array.isArray(it.body)) docs = docs.concat(it.body);\n  else if (it && it.body) docs.push(it.body);\n  else docs.push(it);\n}\n\nconst getField = (d, k) => {\n  if (!d) return null;\n  if (d.fields && d.fields[k] !== undefined) {\n    const f = d.fields[k];\n    if (f === null || f === undefined) return null;\n    if (f.stringValue !== undefined) return f.stringValue;\n    if (f.integerValue !== undefined) return parseInt(f.integerValue);\n    if (f.booleanValue !== undefined) return f.booleanValue;\n    if (f.doubleValue !== undefined) return parseFloat(f.doubleValue);\n    return null;\n  }\n  return d[k] !== undefined ? d[k] : null;\n};\n\nconst getId = (d) => {\n  if (!d) return '';\n  if (d.id) return d.id;\n  if (d._id) return d._id;\n  if (d.name) return d.name.split('/').pop();\n  return '';\n};\n\nconst nowStr = new Date().toLocaleString('sv-SE', { timeZone: 'America/Argentina/Buenos_Aires' });\nconst nowParts = nowStr.replace(' ', 'T').split('T');\nconst hoy = nowParts[0];\nconst [h, m] = nowParts[1].slice(0, 5).split(':').map(Number);\nlet nowMins = h * 60 + m;\nif (h < 12) nowMins += 24 * 60;\n\nconst ayerD = new Date(nowStr.replace(' ', 'T') + '-03:00');\nayerD.setDate(ayerD.getDate() - 1);\nconst ayer = ayerD.toLocaleDateString('en-CA', { timeZone: 'America/Argentina/Buenos_Aires' });\n\nconst t2m = (time, service) => {\n  const p = String(time || '').split(':').map(Number);\n  if (p.length !== 2 || isNaN(p[0])) return null;\n  let mins = p[0] * 60 + p[1];\n  if (service === 'cena' && p[0] < 12) mins += 24 * 60;\n  return mins;\n};\n\nconst normalizePhone = (v) => {\n  let s = String(v || '').replace(/@s\\.whatsapp\\.net$/i, '').replace(/[^0-9]/g, '');\n  if (!s) return '';\n  if (s.startsWith('0')) s = s.slice(1);\n  if (s.startsWith('54')) return s;\n  return '54' + s;\n};\n\nconst out = [];\nfor (const d of docs) {\n  const id = getId(d);\n  const date = getField(d, 'date');\n  const time = getField(d, 'time');\n  const service = getField(d, 'service') || '';\n  const estado = String(getField(d, 'estado') || '').toLowerCase();\n  const name = String(getField(d, 'customerName') || '').trim();\n  const phone = normalizePhone(getField(d, 'customerPhone') || getField(d, 'phone'));\n  const mesaRaw = String(getField(d, 'mesa') || getField(d, 'tableId') || getField(d, 'mesa_id') || '');\n  const rMins = t2m(time, service);\n  if (!id || !date || rMins === null || !phone || !name) continue;\n  if (!/^r/i.test(id)) continue; // solo reservas (los docs p... son pedidos viejos)\n  if (['cancelado', 'no_show', 'ausente', 'finalizado'].includes(estado)) continue;\n  if (estado === 'pendiente' && !mesaRaw) continue; // pendiente sin mesa: no fue confirmada por un humano\n  const cenaMadrugada = rMins >= 19 * 60;\n  const dateOk = (cenaMadrugada && h < 12) ? date === ayer : date === hoy;\n  if (!dateOk) continue;\n  const until = rMins - nowMins;\n  if (until <= 13 || until > 15) continue;\n  const mesaNum = mesaRaw.replace(/^mesa\\s+/i, '').replace(/^m(?=\\d)/i, '');\n  out.push({ json: {\n    document_id: id,\n    reminder_key: 'reminder15_' + id,\n    phone,\n    name,\n    time,\n    mesa: mesaNum,\n  } });\n}\nreturn out;"
      },
