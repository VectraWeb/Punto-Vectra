rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    // Clientes: sesión anónima (formulario público, solo crear reservas).
    // Staff: debe tener el custom claim `staff: true` (ver functions/admin.js).
    function isAuthenticated() {
      return request.auth != null;
    }
    function isStaff() {
      return request.auth != null && request.auth.token.staff == true;
    }

    // Creación de reservas desde el formulario público: solo campos mínimos,
    // siempre 'pendiente' y sin mesa asignada (imposible forjar reservas confirmadas).
    function isClientReservationCreate() {
      return isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'id', 'customerName', 'partySize', 'time', 'duration',
          'service', 'notes', 'estado', 'date', 'staffId', 'staffName',
          'mesa_id', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 60
        && request.resource.data.partySize is int
        && request.resource.data.partySize >= 1
        && request.resource.data.partySize <= 20
        && request.resource.data['service'] in ['mediodia', 'cena']
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.time is string
        && request.resource.data.time.size() == 5
        && request.resource.data.duration is int
        && request.resource.data.duration >= 30
        && request.resource.data.duration <= 240;
    }

    // ── RESERVATIONS (FLAT) ──────────────────────────────────────────────────
    // Structure: reservations/{reservationId}  (date is a field, not a path segment)
    // Usada por: formulario cliente (create), staff dashboard (read/update/delete), n8n
    match /reservations/{reservationId} {
      allow create: if isClientReservationCreate() || isStaff();
      // PII (customerName, phone): nunca lectura pública.
      allow read:   if isAuthenticated();
      allow update: if isStaff();
      allow delete: if isStaff();
    }

    // ── RESERVATIONS (LEGACY NESTED) — kept for backward compat, prefer flat ──
    match /reservations/{date}/items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── MÉTRICAS DE RESERVAS ─────────────────────────────────────────────────
    // Structure: metricas_reservas/{reservationId}
    // Usada por: useCleaningTimers (saveMetrics) — solo staff
    match /metricas_reservas/{reservationId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
    }

    // ── CONFIG ───────────────────────────────────────────────────────────────
    // Structure: config/{configId}
    // READ: cualquiera (el formulario público lee config/restaurant)
    // WRITE: solo staff
    match /config/{configId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // ── MESAS RESERVADAS ─────────────────────────────────────────────────────
    // Structure: mesasReservadas/{mesaId}_{date}_{service}
    // Usada por: staff (transacciones), n8n/webhook con service account (saltea reglas)
    match /mesasReservadas/{docId} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(['occupied', 'reservationId', 'time', 'partySize']);
      allow delete: if isStaff();
    }

    // ── STAFF ────────────────────────────────────────────────────────────────
    // Structure: staff/{staffId}
    // Solo staff puede leer/escribir (los mozos son datos internos)
    match /staff/{staffId} {
      allow read: if isStaff();
      allow create, update, delete: if isStaff();
    }

    // ── MESAS ────────────────────────────────────────────────────────────────
    // Structure: mesas/{mesaId}
    // Solo staff (el plano y el seed corren dentro del dashboard)
    match /mesas/{mesaId} {
      allow read: if isStaff();
      allow create, update, delete: if isStaff();
    }
  }
}