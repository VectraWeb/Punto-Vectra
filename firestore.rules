rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verifica si el usuario está autenticado.
    // La app firma una sesión anónima al arrancar (src/firebase.js), por lo que
    // las escrituras exigen request.auth != null sin pedir login al usuario.
    // Esto bloquea requests externos sin sesión (scrapers, scripts con curl).
    // NOTA: la sesión anónima NO es autorización real (cualquiera puede crear
    // una). Antes de producción: custom claims de staff + App Check + n8n vía
    // Cloud Function con Admin SDK.
    function isAuthenticated() {
      return request.auth != null;
    }

    // --- RESERVATIONS (FLAT) ---
    // Structure: reservations/{reservationId}  (date is a field, not a path segment)
    // Used by: client form (create), staff dashboard (read/update/delete), n8n
    match /reservations/{reservationId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['customerName', 'date', 'service']);

      // Datos personales (nombres, teléfonos, notas): solo con sesión.
      allow read: if isAuthenticated();

      // hasOnly: la escritura NO puede agregar claves arbitrarias.
      // La lista es la unión de todos los campos que el código escribe hoy
      // (updateLiveState, finalizar, editar reserva completa, timers de limpieza)
      // + campos genéricos del modelo multi-negocio (organizationId, resourceId, metadata).
      allow update: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'id', 'customerName', 'phone', 'customerPhone',
          'partySize', 'tableId', 'mesa_id', 'mesa',
          'resourceId', 'organizationId', 'metadata',
          'time', 'duration', 'service', 'notes',
          'estado', 'liveState', 'stateLog',
          'startedAt', 'leftAt', 'cleaningStartedAt', 'cleaningCompletedAt',
          'staffId', 'staffName', 'source',
          'date', 'createdAt', 'updatedAt',
          'rechazoMotivo', 'canceladoMotivo',
          'notificacion_enviada', 'rechazo_notificado', 'recordatorio15_enviado'
        ]);

      allow delete: if isAuthenticated();
    }

    // --- PEDIDOS DEL BOT ---
    // Structure: pedidos/{pedidoId}
    // Kept separate from reservations so an order never occupies a reservation slot.
    match /pedidos/{pedidoId} {
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['customerName', 'date', 'service', 'pedidoEstado']);

      // Datos personales (teléfonos, direcciones de delivery): solo con sesión.
      allow read: if isAuthenticated();

      allow update: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'pedidoEstado', 'pedidoRechazoMotivo',
          'tiempoPreparacionMin', 'tiempoEnvioMin', 'tiempoTotalMin', 'confirmadoAt'
        ]);

      allow delete: if isAuthenticated();
    }

    // --- RESERVATIONS (LEGACY NESTED) — kept for backward compat, prefer flat ---
    // Contiene datos personales históricos: lectura solo con sesión.
    match /reservations/{date}/items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // --- MÉTRICAS DE RESERVAS ---
    // Structure: metricas_reservas/{reservationId}
    // Used by: useCleaningTimers (saveMetrics) — sin regla explícita Firestore
    // deniega por defecto, por eso se declara aquí.
    match /metricas_reservas/{reservationId} {
      // Métricas internas del negocio: no públicas.
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
    }

    // --- CONFIG ---
    // Structure: config/{configId}
    // Used by: salon-layout (positions), restaurant settings
    // Sin datos personales: lectura pública (la vista cliente lo necesita).
    match /config/{configId} {
      allow read: if true;

      // Solo los campos que escribe la app (settings, sectores y layout).
      // groupOwners: mozo elegido cuando un grupo de mesas cruza sectores.
      allow create, update: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'mesaTipos', 'sectors', 'positions', 'groups', 'groupOwners', 'updatedAt'
        ]);

      allow delete: if isAuthenticated();
    }

    // --- MESAS RESERVADAS ---
    // Structure: mesasReservadas/{mesaId}_{date}_{service}
    // Used by: n8n creates/reads (con service account, que saltea las reglas), staff manages
    match /mesasReservadas/{docId} {
      allow read: if isAuthenticated();

      allow create, update: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'occupied', 'reservationId', 'time', 'partySize'
        ]);

      allow delete: if isAuthenticated();
    }

    // --- STAFF ---
    // Structure: staff/{staffId}
    // Used by: staff authentication, role management
    match /staff/{staffId} {
      // Nombres del staff: solo con sesión.
      allow read: if isAuthenticated();

      allow create, update: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'name', 'active', 'assignedTables', 'createdAt'
        ]);

      allow delete: if isAuthenticated();
    }

    // --- MESAS (LEGACY: restaurante) ---
    // Structure: mesas/{mesaId}
    // Used by: salon floor display, table management, bot de n8n
    match /mesas/{mesaId} {
      // Sin datos personales: lectura pública.
      allow read: if true;

      // Campos legacy + campos genéricos (migración progresiva).
      allow create, update: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'capacity', 'name', 'number', 'shape',
          'organizationId', 'type', 'status', 'position',
          'width', 'height', 'metadata', 'generated', 'updatedAt'
        ]);

      allow delete: if isAuthenticated();
    }

    // --- ORGANIZATIONS ---
    // Structure: organizations/{organizationId} (id "default" = negocio principal)
    // Configuración de negocio: sin datos personales.
    match /organizations/{organizationId} {
      allow read: if true;

      allow create, update: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'businessType', 'logo',
          'configuration', 'bookingFields', 'createdAt', 'updatedAt'
        ]);

      allow delete: if isAuthenticated();
    }

    // --- RESOURCES ---
    // Structure: resources/{resourceId} (negocios no-restaurante)
    // Sin datos personales: lectura pública (vista cliente y bot).
    match /resources/{resourceId} {
      allow read: if true;

      allow create, update: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'organizationId', 'name', 'type', 'capacity', 'status',
          'position', 'width', 'height', 'shape',
          'metadata', 'number', 'generated', 'updatedAt'
        ]);

      allow delete: if isAuthenticated();
    }
  }
}
