rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verifica si el usuario está autenticado
    // TODO: When auth is added, replace `if true` with `if isAuthenticated()`
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Verifica si el usuario es admin/staff
    // TODO: When auth is added, check against a roles claim or staff collection
    function isStaff() {
      return isAuthenticated();
    }

    // --- RESERVATIONS (FLAT) ---
    // Structure: reservations/{reservationId}  (date is a field, not a path segment)
    // Used by: client form (create), staff dashboard (read/update/delete), n8n
    match /reservations/{reservationId} {
      allow create: if request.resource.data.keys().hasAll(['customerName', 'date', 'service']);
      allow read: if true;
      allow update: if request.resource.data.keys().hasAny(['liveState', 'tableId', 'estado']);
      allow delete: if true;
    }

    // --- RESERVATIONS (LEGACY NESTED) — kept for backward compat, prefer flat ---
    match /reservations/{date}/items/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    // --- CONFIG ---
    // Structure: config/{configId}
    // Used by: salon-layout (positions), restaurant settings
    match /config/{configId} {
      // READ: anyone (clients need to see salon layout, capacity, etc.)
      allow read: if true;

      // WRITE: anyone (staff updates settings, layout positions)
      // TODO: Restrict to isStaff() when auth is implemented
      allow write: if true;
    }

    // --- MESAS RESERVADAS ---
    // Structure: mesasReservadas/{mesaId}_{date}_{service}
    // Used by: n8n creates/reads, staff manages
    match /mesasReservadas/{docId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAny(['occupied', 'reservationId']);
    }

    // --- STAFF ---
    // Structure: staff/{staffId}
    // Used by: staff authentication, role management
    match /staff/{staffId} {
      // READ: anyone (needed for login lookup)
      // TODO: Restrict to authenticated users or specific admin roles
      allow read: if true;

      // WRITE: anyone (for now, since there's no real auth)
      // TODO: Restrict to isStaff() or admin-only when auth is implemented
      allow write: if true;
    }

    // --- MESAS ---
    // Structure: mesas/{mesaId}
    // Used by: salon floor display, table management
    match /mesas/{mesaId} {
      // READ: anyone (clients see table layout, staff sees all tables)
      allow read: if true;

      // WRITE: anyone (staff adds/removes/edits tables)
      // TODO: Restrict to isStaff() when auth is implemented
      allow write: if true;
    }
  }
}
