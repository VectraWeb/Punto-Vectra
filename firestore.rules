rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// MODO COMPATIBILIDAD SIN FIREBASE AUTH (TEMPORAL)
//
// Este proyecto no tiene facturación habilitada, por lo que Firebase
// Authentication (Identity Platform) no está disponible (BILLING_NOT_ENABLED).
// Hasta habilitar el plan Blaze + Auth, las reglas NO exigen request.auth.
//
// Al habilitar Auth, restaurar las reglas previas (usuarios/ownerUid/
// userOrganizationId). Este archivo mantiene las restricciones hasOnly de
// campos para limitar escrituras arbitrarias.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // --- RESERVATIONS (FLAT) ---
    match /reservations/{reservationId} {
      allow create: if request.resource.data.keys().hasAll(['customerName', 'date', 'service']);

      allow read: if true;

      allow update: if request.resource.data.keys().hasOnly([
        'id', 'customerName', 'phone', 'customerPhone',
        'partySize', 'tableId', 'mesa_id', 'mesa',
        'resourceId', 'organizationId', 'metadata',
        'branchId', 'customerId', 'serviceIds', 'status',
        'time', 'duration', 'service', 'notes',
        'estado', 'liveState', 'stateLog',
        'startedAt', 'leftAt', 'cleaningStartedAt', 'cleaningCompletedAt',
        'staffId', 'staffName', 'source',
        'date', 'createdAt', 'updatedAt',
        'rechazoMotivo', 'canceladoMotivo',
        'notificacion_enviada', 'rechazo_notificado', 'recordatorio15_enviado'
      ]);

      allow delete: if true;
    }

    // --- PEDIDOS ---
    match /pedidos/{pedidoId} {
      allow create: if request.resource.data.keys().hasAll(['customerName', 'date', 'service', 'pedidoEstado']);

      allow read: if true;

      allow update: if request.resource.data.keys().hasOnly([
        'pedidoEstado', 'pedidoRechazoMotivo', 'status',
        'tiempoPreparacionMin', 'tiempoEnvioMin', 'tiempoTotalMin', 'confirmadoAt',
        'items', 'totals', 'customerId', 'reservationId', 'resourceId',
        'organizationId', 'branchId', 'metadata', 'estado'
      ]);

      allow delete: if true;
    }

    // --- RESERVATIONS (LEGACY NESTED) — lectura, sin escritura ---
    match /reservations/{date}/items/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    // --- MÉTRICAS ---
    match /metricas_reservas/{reservationId} {
      allow read, create, update: if true;
    }

    // --- CONFIG ---
    match /config/{configId} {
      allow read: if true;

      allow create, update: if request.resource.data.keys().hasOnly([
        'mesaTipos', 'sectors', 'positions', 'groups', 'groupOwners', 'updatedAt',
        'businessType', 'organizationName', 'resourceLabel', 'resourcePlural'
      ]);

      allow delete: if true;
    }

    // --- MESAS RESERVADAS (locks atómicos anti doble-booking) ---
    match /mesasReservadas/{docId} {
      allow read: if true;

      allow create, update: if request.resource.data.keys().hasOnly([
        'occupied', 'reservationId', 'time', 'partySize'
      ]);

      allow delete: if true;
    }

    // --- STAFF (mozos, restaurante) ---
    match /staff/{staffId} {
      allow read: if true;

      allow create, update: if request.resource.data.keys().hasOnly([
        'name', 'active', 'assignedTables', 'createdAt'
      ]);

      allow delete: if true;
    }

    // --- MESAS (LEGACY: restaurante) ---
    match /mesas/{mesaId} {
      allow read: if true;

      allow create, update: if request.resource.data.keys().hasOnly([
        'capacity', 'name', 'number', 'shape',
        'organizationId', 'type', 'status', 'position',
        'width', 'height', 'metadata', 'generated', 'updatedAt'
      ]);

      allow delete: if true;
    }

    // --- ORGANIZATIONS ---
    match /organizations/{organizationId} {
      allow read: if true;

      allow create, update: if request.resource.data.keys().hasOnly([
        'id', 'name', 'businessType', 'logo', 'ownerUid',
        'configuration', 'bookingFields', 'closedDates', 'createdAt', 'updatedAt'
      ]);

      allow delete: if true;
    }

    // --- BRANCHES (sucursales) ---
    match /organizations/{organizationId}/branches/{branchId} {
      allow read: if true;

      allow create, update: if request.resource.data.keys().hasOnly([
        'organizationId', 'name', 'address', 'timezone',
        'businessHours', 'settings', 'updatedAt'
      ]);

      allow delete: if branchId != 'main';
    }

    // --- RESOURCES ---
    match /resources/{resourceId} {
      allow read: if true;

      allow create, update: if request.resource.data.keys().hasOnly([
        'organizationId', 'name', 'type', 'capacity', 'status',
        'position', 'width', 'height', 'shape',
        'metadata', 'number', 'generated', 'updatedAt'
      ]);

      allow delete: if true;
    }

    // --- CATALOG ---
    match /catalog/{itemId} {
      allow read: if true;

      allow create, update: if request.resource.data.keys().hasOnly([
        'organizationId', 'branchId', 'type', 'name', 'description',
        'categoryId', 'price', 'duration', 'active', 'metadata', 'updatedAt'
      ]);

      allow delete: if true;
    }

    // --- CUSTOMERS ---
    match /customers/{docId} {
      allow read: if true;

      allow create, update: if request.resource.data.keys().hasOnly([
        'organizationId', 'branchId', 'name', 'phone', 'email',
        'contact', 'tags', 'notes', 'preferences', 'stats', 'createdAt', 'updatedAt'
      ]);

      allow delete: if true;
    }

    // --- USERS (sin uso en modo compatibilidad) ---
    match /users/{uid} {
      allow read, create, update: if request.resource.data.keys().hasOnly([
        'organizationId', 'email', 'role', 'permissions', 'name', 'createdAt'
      ]);
      allow delete: if true;
    }

    // --- AUDIT LOGS ---
    match /auditLogs/{logId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly([
        'organizationId', 'actorId', 'action', 'entityType', 'entityId',
        'previousData', 'newData', 'metadata', 'createdAt'
      ]);
    }
  }
}
