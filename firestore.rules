rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verifica si el usuario está autenticado
    // TODO: When auth is added, replace `if true` with `if isAuthenticated()`
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Verifica si el usuario es admin/staff
    // TODO: When auth is added, check against a roles claim or staff collection
    function isStaff() {
      return isAuthenticated();
    }

    // --- RESERVATIONS ---
    // Structure: reservations/{date}/items/{reservationId}
    // Used by: client form (create), staff dashboard (read/update/delete)
    match /reservations/{date}/items/{reservationId} {
      // CREATE: anyone can create (client reservation form via QR)
      // TODO: Add validation for required fields (name, phone, time, guests)
      allow create: if true;

      // READ: anyone can read (staff dashboard needs full access)
      // TODO: Restrict to isStaff() when auth is implemented
      allow read: if true;

      // UPDATE: anyone can update (staff changes status: eating, dessert, etc.)
      // TODO: Restrict to isStaff() when auth is implemented
      allow update: if true;

      // DELETE: anyone can delete (staff cancels reservations)
      // TODO: Restrict to isStaff() when auth is implemented
      allow delete: if true;
    }

    // --- CONFIG ---
    // Structure: config/{configId}
    // Used by: salon-layout (positions), restaurant settings
    match /config/{configId} {
      // READ: anyone (clients need to see salon layout, capacity, etc.)
      allow read: if true;

      // WRITE: anyone (staff updates settings, layout positions)
      // TODO: Restrict to isStaff() when auth is implemented
      allow write: if true;
    }

    // --- MESAS RESERVADAS ---
    // Structure: mesasReservadas/{date}/{mesaId}
    // Used by: tracking which tables are reserved for a given date
    match /mesasReservadas/{date}/{mesaId} {
      // READ: anyone (clients see available tables, staff sees reservations)
      allow read: if true;

      // WRITE: anyone (reservation system and staff manage table assignments)
      // TODO: Restrict to isStaff() for delete, allow create for reservation flow
      allow write: if true;
    }

    // --- STAFF ---
    // Structure: staff/{staffId}
    // Used by: staff authentication, role management
    match /staff/{staffId} {
      // READ: anyone (needed for login lookup)
      // TODO: Restrict to authenticated users or specific admin roles
      allow read: if true;

      // WRITE: anyone (for now, since there's no real auth)
      // TODO: Restrict to isStaff() or admin-only when auth is implemented
      allow write: if true;
    }

    // --- MESAS ---
    // Structure: mesas/{mesaId}
    // Used by: salon floor display, table management
    match /mesas/{mesaId} {
      // READ: anyone (clients see table layout, staff sees all tables)
      allow read: if true;

      // WRITE: anyone (staff adds/removes/edits tables)
      // TODO: Restrict to isStaff() when auth is implemented
      allow write: if true;
    }
  }
}
