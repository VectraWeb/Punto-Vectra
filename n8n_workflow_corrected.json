      "parameters": {
        "jsCode": "const data = $('Prepare Reservation').item.json;\n\nlet mensaje;\nif (data.has_table) {\n  mensaje = `✅ *¡Reserva confirmada!*\\n\\n📍 Mesa: *${data.assigned_table_name}*\\n👤 ${data.customerName} · ${data.requested_party_size} personas\\n📅 ${data.requested_date} a las ${data.requested_time}\\n\\nTe esperamos en *Andi*. ¡Hasta pronto! 🍽️`;\n} else {\n  mensaje = `⏳ *Reserva recibida*\\n\\n👤 ${data.customerName} · ${data.requested_party_size} personas\\n📅 ${data.requested_date} a las ${data.requested_time}\\n\\nNo encontramos mesa disponible para ese horario. Te contactaremos pronto para confirmar. 🙏`;\n}\n\nreturn [{ json: { mensaje } }];"
      },
